PORT=4000
# Obrigatório em todos os ambientes: o backend falha no boot se estiver ausente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filtrovali?schema=public"
ASSETS_DIR="./assets"
REPORTS_DIR="./Relatórios"
# Raiz dos arquivos do módulo Comercial: fotos de escopo e documentos emitidos.
# Vazio ou ausente usa "<REPORTS_DIR>/Comercial", que é onde as fotos já estão —
# apontar para outro lugar sem mover o conteúdo deixa as fotos antigas para trás.
# Precisa entrar no backup (a pasta guarda o PDF que foi ao cliente).
COMERCIAL_DIR=""

# Envio da proposta ao CRM Nectar.
#
# ATENÇÃO: o Nectar NÃO TEM SANDBOX. A API publica uma URL só, de produção
# (https://app.nectarcrm.com.br/crm/api/1/) — não existe homologação para onde
# apontar. Qualquer chamada com NECTAR_MODE=real cria card no CRM da empresa.
#
#   off   não tenta, e a finalização diz que o envio está desligado (PADRÃO)
#   fake  responde como se tivesse dado certo, sem tocar na rede (dev e testes)
#   real  usa o token
NECTAR_MODE="off"
# Configurações > Integrações > Gerar Token. O token herda as permissões do
# USUÁRIO RESPONSÁVEL escolhido na criação — em ambiente de teste, use um
# usuário restrito e um período de validade curto.
NECTAR_API_TOKEN=""
# Lista branca de funis, separada por vírgula. Vazia RECUSA TUDO — é a contenção
# que não depende do fornecedor: teste aponta para um funil de testes, e um erro
# de código não alcança o funil onde o comercial trabalha.
NECTAR_PIPELINE_IDS=""

# Grava os documentos no SharePoint, via Microsoft Graph.
#
# Mesmos tres modos, e `off` tambem e o padrao: o destino e a biblioteca REAL da
# empresa, e nao existe copia de teste dela.
SHAREPOINT_MODE="off"
# Registro de aplicativo no Entra ID, com permissao de aplicativo Sites.ReadWrite.All.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Ex.: filtrovali.sharepoint.com
SHAREPOINT_HOSTNAME=""
# Ex.: /sites/ArquivosFiltrovali
SHAREPOINT_SITE_PATH=""
# TUDO e criado dentro desta pasta — e a contencao que nao depende da Microsoft.
# Em ambiente de teste, aponte para uma pasta de testes.
SHAREPOINT_BASE_FOLDER="02 - Comercial/Projetos em cotação"

# URL base do sistema (usado nos links de e-mail)
# Exemplo local: http://localhost:5173
# Exemplo produção: https://relatorios.suaempresa.com.br
APP_URL="http://localhost:5173"
# Obrigatório em produção. Use "false" somente se o backend não estiver atrás de proxy.
# Em Docker com Nginx na rede interna, prefira "uniquelocal" ou CIDRs explícitos.
TRUST_PROXY=false
# Obrigatório em produção para tokens de pesquisa.
# Em upgrade de uma instalação existente, configure SURVEY_TOKEN_SECRET_PREVIOUS
# com o segredo antigo usado pelos tokens já emitidos (se antes não havia
# SURVEY_TOKEN_SECRET, o segredo antigo era o valor do DATABASE_URL de então).
# Aceita uma lista separada por vírgula. A cifra sempre usa o segredo atual.
SURVEY_TOKEN_SECRET="troque-por-um-segredo-longo-e-estavel"
SURVEY_TOKEN_SECRET_PREVIOUS=""
# Obrigatório em produção para links de assinatura de RDO.
# Em upgrade de uma instalação existente, configure SIGNATURE_TOKEN_SECRET_PREVIOUS
# com o segredo antigo usado pelos tokens já emitidos.
SIGNATURE_TOKEN_SECRET="troque-por-outro-segredo-longo-e-estavel"
SIGNATURE_TOKEN_SECRET_PREVIOUS=""

# Configurações SMTP — Microsoft Exchange
# Exchange Online (M365): SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Exchange on-premises:   SMTP_HOST=<endereço do servidor interno>  SMTP_PORT=587
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="email_da_empresa@suaempresa.com.br"
SMTP_PASS="senha_ou_app_password"
SMTP_FROM="Filtrovali <email_da_empresa@suaempresa.com.br>"

# Defina false em homologação/testes com banco de produção para bloquear envios operacionais do sistema.
# O script scripts/test-email.js continua podendo enviar somente para SMTP_TEST_DEST.
SEND_CLIENT_EMAILS=true

# Observabilidade operacional
# Monte esses arquivos no container do backend se quiser que /api/operations/status
# alerte backup/restore velho, ausente ou com falha.
OPERATIONS_BACKUP_STATUS_FILE=""
OPERATIONS_RESTORE_STATUS_FILE=""
OPERATIONS_REQUIRE_BACKUP_STATUS=false
OPERATIONS_REQUIRE_RESTORE_STATUS=false
OPERATIONS_BACKUP_MAX_AGE_HOURS=26
OPERATIONS_RESTORE_MAX_AGE_DAYS=30

# Job opcional que envia alerta quando /api/operations/status encontra problemas.
OPERATIONS_ALERT_JOB_ENABLED=false
OPERATIONS_ALERT_INTERVAL_MS=3600000
OPERATIONS_ALERT_WEBHOOK_URL=""

# Webhook opcional para rastreamento centralizado de erros backend/frontend.
ERROR_TRACKING_PROVIDER="webhook"
ERROR_TRACKING_WEBHOOK_URL=""

# Build do frontend no Docker/Nginx. O compose lê essas variáveis quando usado
# com --env-file backend/.env.production ou backend/.env.staging.
VITE_ERROR_TRACKING_ENABLED=false
VITE_ERROR_TRACKING_ENDPOINT=""

# E-mail de destino apenas para o script de teste (scripts/test-email.js)
SMTP_TEST_DEST="seu_email@example.com"

# Token de serviço para o envio do banco comercial Access (propostas_bd.accdb) via API.
# Usado pelo script periódico do comercial (POST /api/acompanhamento/comercial/import).
# Gere um valor longo e aleatório (ex.: openssl rand -hex 32). Vazio = endpoint desabilitado.
COMMERCIAL_IMPORT_TOKEN=""

# Integração Omie (compras por projeto). App Key/Secret da aplicação Omie.
# Usados pelo script de descoberta (npm run omie:explore) e pela sincronização.
OMIE_APP_KEY=""
OMIE_APP_SECRET=""
# Job agendado da sincronização Omie (in-process). Habilite em produção/staging.
# Atualiza projetos/categorias e puxa as compras incrementais (janela em dias).
# O backfill completo continua manual: npm run omie:sync compras
OMIE_SYNC_ENABLED=false
OMIE_SYNC_INTERVAL_MINUTES=360
OMIE_SYNC_SINCE_DAYS=7
