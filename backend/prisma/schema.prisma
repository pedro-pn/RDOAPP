// ===========================================================================
// Módulo Comercial — schema `comercial`
//
// Porte de ~/comercialAPP (congelado em 6f5b072). Modelagem em
// specs/009-modulo-comercial/data-model.md.
//
// Regras que valem para todos os models daqui:
//   - dinheiro em Decimal(14,2) e margem em Decimal(6,2). NUNCA Float:
//     float em dinheiro produz centavo errado, e aqui centavo errado vira
//     preço errado numa proposta que já foi ao cliente.
//   - `createdByUserId` sustenta a regra de autoria (FR-029): vendedor
//     alcança só o que é seu, gestor alcança tudo.
//   - `archivedAt` em vez de exclusão. NÃO HÁ DELETE em nenhuma rota do
//     módulo (FR-060).
// ===========================================================================

/// Os dois modos da referencia (`type EstimateMode = "new" | "revision"`).
/// NAO existe um modo "levantar": no diálogo de `/` a opção "Levantar custos"
/// é um LINK para a tela de custos, não um modo de levantamento.
enum CostEstimateMode {
  NOVA
  REVISAO

  @@schema("comercial")
}

enum CostEstimateStatus {
  RASCUNHO
  SALVO

  @@schema("comercial")
}

enum ProposalStatus {
  RASCUNHO
  FINALIZANDO
  FINALIZADA
  FALHA_INTEGRACAO

  @@schema("comercial")
}

/// Estado de UM destino externo — Nectar ou SharePoint —, separado do estado da
/// proposta. Os dois falham independentemente: o card pode entrar no CRM e a
/// pasta não ser criada, e a mensagem ao usuário precisa dizer qual dos dois.
enum ProposalIntegrationStatus {
  PENDENTE
  SUCESSO
  ERRO

  @@schema("comercial")
}

enum ProposalDocumentKind {
  COMERCIAL
  TECNICA

  @@schema("comercial")
}

enum SalesAttributionKind {
  REPRESENTANTE
  INDICACAO

  @@schema("comercial")
}

enum ProposalAuditAction {
  FINALIZADA
  INTEGRACAO_ENVIADA
  INTEGRACAO_FALHOU
  ARQUIVADA
  DESARQUIVADA

  @@schema("comercial")
}

/// Levantamento de custos. É ele que carimba o código que os dois documentos usam.
model CostEstimate {
  id               String             @id @default(cuid())
  proposalCode     String
  revisionNumber   Int                @default(0)
  title            String
  mode             CostEstimateMode
  status           CostEstimateStatus @default(RASCUNHO)
  /// Payload completo do levantamento. Contrato validado por
  /// shared/schemas/comercial.js e por normalizeCostEstimatePayload.
  payload          Json
  /// Totais SEMPRE recalculados no servidor com calculateEstimate.
  /// Os valores enviados pelo cliente são ignorados — é o que impede forjar margem.
  totalCost        Decimal            @db.Decimal(14, 2)
  salePrice        Decimal            @db.Decimal(14, 2)
  marginPercent    Decimal            @db.Decimal(6, 2)
  createdByUserId  String
  createdBy        User               @relation("ComercialCostEstimateAuthor", fields: [createdByUserId], references: [id])
  /// Última pessoa que editou. O rótulo é congelado para que renomear a conta
  /// depois não reescreva a mensagem de concorrência (FR-070).
  updatedByUserId  String?
  updatedBy        User?              @relation("ComercialCostEstimateUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByLabel   String?
  archivedAt       DateTime?
  archivedByUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  versions     CostEstimateVersion[]
  attributions SalesAttribution[]
  proposals    Proposal[]

  /// Consulta da listagem filtrada por autoria: vendedor vê só os seus.
  @@index([createdByUserId, archivedAt, createdAt])
  @@index([proposalCode, revisionNumber])
  @@schema("comercial")
}

/// Versão imutável do levantamento. Nunca sofre update — versão que muda não é versão.
model CostEstimateVersion {
  id             String       @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)
  /// Hash do payload: é o que torna a versão verificável.
  payloadHash    String
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@index([costEstimateId, createdAt])
  @@schema("comercial")
}

/// Proposta gerada pelo app.
/// ATENÇÃO: distinta de `CommercialProposal`, que já existe e é o staging do
/// import do Access. Confundir as duas é erro fácil de cometer e caro de achar.
model Proposal {
  id             String        @id @default(cuid())
  proposalCode   String
  revisionNumber Int           @default(0)
  costEstimateId String?
  costEstimate   CostEstimate? @relation(fields: [costEstimateId], references: [id])

  clientName String
  cnpj       String
  contact    String
  email      String
  site       String
  department String?

  /// Vínculo com o usuário que é o consultor de vendas...
  sellerUserId  String
  seller        User   @relation("ComercialProposalSeller", fields: [sellerUserId], references: [id])
  /// ...e o nome no momento da emissão. Os dois, não um: desativar ou renomear
  /// um usuário NÃO PODE alterar proposta já emitida (FR-041a). O PDF já foi ao
  /// cliente com aquele nome.
  sellerName    String
  estimatorName String

  payload    Json
  totalValue Decimal        @db.Decimal(14, 2)
  status     ProposalStatus @default(RASCUNHO)

  /// Finalização é exclusiva (FR-069): a segunda tentativa usa estes campos
  /// para dizer quando e por quem já foi finalizada.
  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedBy       User?     @relation("ComercialProposalFinalizer", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  finalizedByLabel  String?

  /// --- Integrações externas ---
  ///
  /// Guardadas por destino, e não num campo só, porque os dois falham
  /// independentemente: o card entra no Nectar e a pasta do SharePoint não é
  /// criada, e a resposta precisa dizer QUAL falhou. `integrationError` é o
  /// texto que o usuário lê; os PDFs continuam baixáveis em qualquer caso
  /// (FR-034).
  nectarStatus        ProposalIntegrationStatus @default(PENDENTE)
  /// O card no CRM. Havendo vínculo salvo, a revisão REUTILIZA este card em vez
  /// de abrir outro (FR-066) — é o que a T053b consulta.
  nectarOpportunityId String?
  nectarPipelineId    String?
  /// O nome do funil no momento da emissão. Renomear o funil no CRM depois não
  /// pode reescrever o que a proposta registrou — mesma regra do `sellerName`.
  nectarPipelineName  String?
  sharepointStatus    ProposalIntegrationStatus @default(PENDENTE)
  sharepointFolder    String?
  integrationError    String?

  createdByUserId  String
  createdBy        User      @relation("ComercialProposalAuthor", fields: [createdByUserId], references: [id])
  /// Última edição mutável. Finalização tem autoria própria logo acima.
  updatedByUserId  String?
  updatedBy        User?     @relation("ComercialProposalUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByLabel   String?
  archivedAt       DateTime?
  archivedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents   ProposalDocument[]
  attachments ProposalAttachment[]
  scopeAssets ScopeAsset[]
  auditLogs   ProposalAuditLog[]

  @@unique([proposalCode, revisionNumber])
  @@index([createdByUserId, archivedAt, createdAt])
  @@index([sellerUserId, createdAt])
  @@index([status])
  /// A revisão procura o card salvo pelo código da proposta (FR-066).
  @@index([proposalCode, nectarOpportunityId])
  @@schema("comercial")
}

/// Documento gerado na finalização (comercial ou técnica).
/// Gravado ANTES de qualquer tentativa de integração: se a integração falhar
/// depois, os documentos continuam baixáveis (FR-034).
model ProposalDocument {
  id          String               @id @default(cuid())
  proposalId  String
  proposal    Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  kind        ProposalDocumentKind
  storagePath String
  byteSize    Int
  createdAt   DateTime             @default(now())

  @@index([proposalId, kind])
  @@schema("comercial")
}

/// Arquivo adicional do cliente (ART, folha de dados, especificação).
/// Vai para a MESMA pasta dos dois documentos no destino externo.
model ProposalAttachment {
  id              String   @id @default(cuid())
  proposalId      String
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  storagePath     String
  originalName    String
  /// Conta no limite AGREGADO do envio (FR-059): dois PDFs + planilha + anexos.
  byteSize        Int
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([proposalId])
  @@schema("comercial")
}

/// Foto de item de escopo. Renderizada dentro do PDF, diferente do anexo.
/// Sobrevive às revisões (FR-051): revisar não exige reenviar imagem.
model ScopeAsset {
  id              String   @id @default(cuid())
  proposalId      String
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// Padrão da referência: escopo/AAAA/MM/<uuid>.<ext>
  storagePath     String
  contentType     String
  originalName    String
  /// Máximo 1.500.000 após a otimização no cliente (FR-050).
  byteSize        Int
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([proposalId])
  @@schema("comercial")
}

/// Representantes e indicações internas.
model SalesAttribution {
  id             String               @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate         @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)
  kind           SalesAttributionKind
  beneficiary    String
  /// Pontos-base — já inteiro na origem, não converter para Decimal.
  commissionBps  Int
  createdAt      DateTime             @default(now())

  @@index([costEstimateId])
  @@schema("comercial")
}

/// Auditoria das ações irreversíveis: finalização e envio externo.
model ProposalAuditLog {
  id          String              @id @default(cuid())
  proposalId  String
  proposal    Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  action      ProposalAuditAction
  actorUserId String
  detail      Json?
  createdAt   DateTime            @default(now())

  @@index([proposalId, createdAt])
  @@schema("comercial")
}

/// Estado da numeração de propostas do módulo Comercial.
///
/// Linha única (`id = "singleton"`). Existe porque a sequence do Postgres não
/// sabe dizer se já foi semeada: `last_value = 1` tanto significa "recém-criada"
/// quanto "emitiu o número 1". Emitir numeração antes de conhecer o maior número
/// já usado no CRM Nectar e em CommercialProposal geraria código repetido — e
/// esse código vai no documento que chega ao cliente.
///
/// A semeadura é operação de servidor: roda uma vez, manualmente, e marca
/// `seededAt`. Até lá a rota de numeração recusa em vez de inventar.
model ProposalNumberingState {
  id            String    @id @default("singleton")
  seededAt      DateTime?
  seededByLabel String?
  /// Maior número encontrado no levantamento que originou a semeadura.
  seedValue     Int?

  @@schema("comercial")
}

/// Configuração do módulo Comercial, editável por gestor (T131).
///
/// Linha única (`id = "singleton"`), como a numeração.
///
/// Nasceu do endereço da sede, que era `COMERCIAL_SEDE_ENDERECO` no `.env`. É
/// **dado de negócio**, não de ambiente: muda quando a empresa muda de prédio,
/// quem sabe o endereço novo é o gestor, e trocá-lo exigia editar arquivo no
/// servidor e reiniciar o container. Decisão do mantenedor em 12/08.
///
/// O endereço é guardado em duas formas, e as duas importam:
///
/// - `sedeAddress` — o que o gestor digitou, que é o que ele reconhece ao voltar
///   na tela;
/// - `sedePlaceId` — o identificador do Google, resolvido na hora de salvar. É
///   ele que vai como origem da rota, para o Google **não** reinterpretar o
///   texto por conta própria a cada cálculo e mudar a origem sem ninguém pedir.
model ComercialSettings {
  id                   String   @id @default("singleton")
  /// Origem de toda distância calculada. Vazio = cálculo automático indisponível.
  sedeAddress          String   @default("")
  /// O endereço oficial que o Google devolveu, para a tela mostrar o que gravou.
  sedeFormattedAddress String?
  sedePlaceId          String?
  updatedAt            DateTime @updatedAt
  updatedByUserId      String?
  /// Nome de quem editou, congelado: a tela mostra sem precisar de join.
  updatedByLabel       String?

  @@schema("comercial")
}

/// Quem já viu o tutorial de primeiro acesso do módulo (FR-025a, T096).
///
/// **Por usuário e no servidor**, não em `localStorage`: no navegador, dois
/// usuários da mesma máquina compartilhariam o marcador, e o mesmo usuário veria
/// o tutorial de novo em outro computador. O tutorial acompanha a pessoa.
///
/// A campanha de novidade de 10 dias continua no navegador (FR-025b) — ela
/// acompanha o **dispositivo**, e são dois mecanismos com propósitos diferentes.
///
/// Sem `updatedAt`: ver o tutorial é evento, não estado que se edita. Reabrir
/// pelo botão "Rever tutorial" não mexe aqui — o marcador diz "já apareceu
/// sozinho uma vez", e é só isso que ele precisa dizer.
model ComercialTutorialSeen {
  /// FK lógica → `public.User`. Sem relação declarada, como o resto do módulo.
  userId String   @id
  seenAt DateTime @default(now())

  @@schema("comercial")
}

/// Foto de um bloco de conteúdo do escopo.
///
/// Vive separada do payload da proposta porque **sobrevive às revisões** (FR-051):
/// revisar não exige reenviar a foto. O bloco guarda só o id; o arquivo fica no disco
/// sob `uploadDir/Comercial/escopo/AAAA/MM/`, com nome de UUID.
model ScopePhotoAsset {
  id               String   @id @default(uuid())
  /// Caminho RELATIVO à raiz de fotos. Absoluto amarraria o banco à máquina.
  assetKey         String   @unique
  contentType      String
  byteSize         Int
  /// Nome original saneado, guardado só para exibição.
  fileName         String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@schema("comercial")
}
