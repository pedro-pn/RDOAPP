  @@schema("public")
}

enum BudgetSelectionStatus {
  UNKNOWN
  CHOSEN
  LOST

  @@schema("public")
}

// Unidade de medida do quantitativo previsto de serviços (escopo vendido).
// Em uso hoje: M (tubulação) e L (óleo) — as que casam com o realizado do RDO. KG/T/UN ficam
// reservadas para quando o RDO passar a capturar peso/tanques (sem fonte de realizado por ora).
enum PlannedMeasureUnit {
  M // metros (tubulação)
  KG // quilos (reservado)
  T // toneladas (reservado)
  UN // unidades (reservado)
  L // litros (óleo)

  @@schema("public")
}

enum AccessImportSource {
  SCRIPT
  MANUAL

  @@schema("public")
}

enum AccessImportStatus {
  SUCCESS
  PARTIAL
  ERROR

  @@schema("public")
}

enum AcompanhamentoMissionGroupStatus {
  ACTIVE
  DISSOLVED

  @@schema("public")
}

enum QualityRecordType {
  DESVIO
  LICAO_APRENDIDA
  INCIDENTE
  RECLAMACAO_CLIENTE
  MELHORIA

  @@schema("public")
}

enum QualityEvidenceKind {
  LINK
  ATTACHMENT

  @@schema("public")
}

enum QualityImpact {
  ALTO
  MEDIO
  BAIXO

  @@schema("public")
}

enum QualityDisposition {
  TRATAR
  MONITORAR
  ARQUIVAR_DIVULGAR

  @@schema("public")
}

enum QualityStatus {
  ABERTO
  EM_TRIAGEM
  EM_OBSERVACAO
  EM_ACAO
  FECHADO
  DIVULGADO

  @@schema("public")
}

model Collaborator {
  id                        String                           @id @default(cuid())
  code                      String                           @unique
  name                      String
  role                      String
  email                     String?
  cpf                       String?
  registrationNumber        String?
  admissionDate             DateTime?
  signatureImage            String?
  signatureNoticeAcceptedAt DateTime?
  signatureNoticeVersion    String?
  isActive                  Boolean                          @default(true)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  projectsLed               Project[]                        @relation("ProjectOperator")
  reportLinks               ReportCollaborator[]
  user                      User?
  epiRecords                EpiRecord[]
  epiSignatureRequests      EpiSignatureRequest[]
  signatureNoticeLogs       CollaboratorSignatureNoticeLog[]
  pontoPeriods              PontoPeriodSummary[]
  pontoNameAliases          PontoNameAlias[]

  @@schema("public")
}

model CollaboratorSignatureNoticeLog {
  id             String       @id @default(cuid())
  collaboratorId String
  userId         String?
  noticeVersion  String
  createdAt      DateTime     @default(now())
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  user           User?        @relation("CollaboratorSignatureNoticeUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([collaboratorId])
  @@index([userId])
  @@index([createdAt])
  @@schema("public")
}

model ClientSegment {
  id        String   @id @default(cuid())
  label     String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// Motor de custo de colaborador: perfil + parâmetros versionados.
// Um perfil pode ser vinculado a um cargo (JobRole) — nesse caso é o custo daquele cargo.
model CostProfile {
  id            String             @id @default(cuid())
  key           String             @unique // operador, auxiliar, role:<jobRoleId>
  label         String
  jobRoleId     String?            @unique // quando setado, é o perfil de custo de um cargo
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  parameterSets CostParameterSet[]
  jobRole       JobRole?           @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  @@schema("public")
}

model CostParameterSet {
  id              String      @id @default(cuid())
  costProfileId   String
  version         Int
  effectiveDate   DateTime    @db.Date
  params          Json // campos "amarelos" da planilha (salário, %s, benefícios, FGTS, multa)
  note            String?
  createdByUserId String?
  createdAt       DateTime    @default(now())
  profile         CostProfile @relation(fields: [costProfileId], references: [id], onDelete: Cascade)

  @@unique([costProfileId, version])
  @@index([costProfileId])
  @@index([costProfileId, effectiveDate])
  @@schema("public")
}

// Configurações globais do módulo Acompanhamento (chave/valor). Ex.: custo de EPI por colaborador.
model AcompanhamentoSetting {
  key             String   @id
  numberValue     Float?
  updatedByUserId String?
  updatedAt       DateTime @default(now()) @updatedAt

  @@schema("public")
}

// === Ponto (jornada) importado do Pontomais — base do custo de mão de obra (HH) ===
// Enquanto não há integração automática com o VR Ponto Mais, a planilha de jornada é enviada
// manualmente (semanal). Cada import guarda auditoria + um resumo por colaborador no período.

model PontoImport {
  id                   String               @id @default(cuid())
  fileName             String
  contentHash          String // sha256 hex do arquivo (idempotência)
  periodStart          DateTime             @db.Date
  periodEnd            DateTime             @db.Date
  rowsRead             Int                  @default(0)
  collaboratorsTotal   Int                  @default(0)
  collaboratorsMatched Int                  @default(0)
  summary              Json?
  status               String               @default("OK")
  importedByUserId     String?
  createdAt            DateTime             @default(now())
  periods              PontoPeriodSummary[]

  @@index([createdAt])
  @@index([contentHash])
  @@schema("public")
}

// Resumo por colaborador × import: horas normais + split HE70/HE100 (só existe no "Resumo" da
// planilha) + dias trabalhados (para cruzar com RDO e derivar dias de viagem).
model PontoPeriodSummary {
  id             String        @id @default(cuid())
  importId       String
  collaboratorId String? // null até o nome ser vinculado a um Collaborator
  rawName        String
  normalizedName String
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  workedMinutes  Int           @default(0)
  he70Minutes    Int           @default(0)
  he100Minutes   Int           @default(0)
  nightMinutes   Int           @default(0)
  workedDates    String[]      @default([]) // ["YYYY-MM-DD", ...] dias com horas normais > 0
  monthly        Json? // { "YYYY-MM": { normalMinutes, extrasMinutes, nightMinutes, workedDates[] } }
  createdAt      DateTime      @default(now())
  import         PontoImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  collaborator   Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)

  @@unique([importId, normalizedName])
  @@index([collaboratorId])
  @@index([importId])
  @@schema("public")
}

// Lembra vínculos manuais nome-do-ponto → colaborador (variações de caixa/apelido entre imports).
model PontoNameAlias {
  id              String       @id @default(cuid())
  normalizedName  String       @unique
  rawName         String
  collaboratorId  String
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  collaborator    Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@schema("public")
}

// Lista gerenciável de cargos (substitui o texto livre em Collaborator.role).
model JobRole {
  id                 String                      @id @default(cuid())
  name               String                      @unique
  order              Int                         @default(0)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  plannedNormalHours ProjectPlannedNormalHours[]
  plannedOvertime    ProjectPlannedOvertime[]
  costProfile        CostProfile?

  @@index([isActive, order])
  @@schema("public")
}

// Lista gerenciável de temas de DDS abordados nos RDOs (gestores e coordenadores).
model DdsTheme {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@schema("public")
}

model Project {
  id                             String  @id @default(cuid())
  code                           String  @unique
  name                           String
  isActive                       Boolean @default(true)
  visibleToCollaborators         Boolean @default(true)
  managerOnly                    Boolean @default(false)
  registrationPending            Boolean @default(false)
  inhibitionServiceEnabled       Boolean @default(false)
  requireServiceReportSignatures Boolean @default(false)
  offshore                       Boolean @default(false) // projeto offshore: +transferência no custo de MO
  laborSleepModeByCollaborator   Json    @default("{}") // Acompanhamento: collaboratorId -> HOME/AWAY para RDO não-offshore
  laborCollaboratorIds           Json    @default("[]") // Acompanhamento: colaboradores adicionados manualmente ao cronograma

  clientName                 String
  clientCnpj                 String
  clientEmailPrimary         String                             @default("")
  clientSignerFirstName      String                             @default("")
  clientSignerLastName       String                             @default("")
  clientEmailCc              String[]                           @default([])
  clientSigners              Json[]                             @default([])
  contractCode               String
  location                   String
  workdayHours               String                             @default("09:00")
  weekendWorkdayHours        String                             @default("08:00")
  includesSaturday           Boolean                            @default(false)
  includesSunday             Boolean                            @default(false)
  operatorId                 String?
  clientSegment              String?
  commercialProposalCode     String? // = cod_prop do Access; reconciliação proposta↔projeto
  mobilizationDate           DateTime? // data de mobilização (manual, gestor/coordenador)
  startDate                  DateTime? // início real da execução (manual, gestor/coordenador)
  manualProgressPct          Decimal?                           @db.Decimal(5, 2) // avanço informado à mão (fallback quando não há escopo)
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  deletedAt                  DateTime?
  operator                   Collaborator?                      @relation("ProjectOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  reportSequences            ProjectReportSeq[]
  authorizedUsers            ProjectAuthorizedUser[]
  reports                    Report[]
  drafts                     ReportDraft[]
  surveys                    SatisfactionSurvey[]
  romaneios                  Romaneio[]
  budgets                    ProjectBudget[]
  omieProjects               OmieProject[]
  omiePurchases              OmiePurchase[]
  omieReceivables            OmieReceivable[]
  plannedServices            ProjectPlannedService[]
  plannedNormalHours         ProjectPlannedNormalHours[]
  plannedOvertime            ProjectPlannedOvertime[]
  stockMovements             StockMovement[]
  manualProgressHistory      ProjectManualProgressHistory[]
  manualCosts                ProjectManualCost[]
  additionalProposals        ProjectAdditionalProposal[]
  acompanhamentoGroupMembers AcompanhamentoMissionGroupMember[]
  qualityRecords             QualityRecord[]

  @@index([deletedAt])
  @@index([registrationPending])
  @@index([commercialProposalCode])
  @@schema("public")
}

model ProjectManualProgressHistory {
  id          String   @id @default(cuid())
  projectId   String
  progressPct Decimal  @db.Decimal(5, 2)
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recordedAt])
  @@schema("public")
}

model ProjectManualCost {
  id              String    @id @default(cuid())
  projectId       String
  description     String
  amount          Decimal   @db.Decimal(12, 2)
  costDate        DateTime?
  note            String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("ProjectManualCostCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, deletedAt])
  @@index([createdByUserId])
  @@schema("public")
}

model AcompanhamentoMissionGroup {
  id                String                             @id @default(cuid())
  name              String
  status            AcompanhamentoMissionGroupStatus   @default(ACTIVE)
  createdByUserId   String?
  dissolvedByUserId String?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  dissolvedAt       DateTime?
  createdBy         User?                              @relation("AcompanhamentoMissionGroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  dissolvedBy       User?                              @relation("AcompanhamentoMissionGroupDissolvedBy", fields: [dissolvedByUserId], references: [id], onDelete: SetNull)
  members           AcompanhamentoMissionGroupMember[]

  @@index([status, createdAt])
  @@index([createdByUserId])
  @@index([dissolvedByUserId])
  @@schema("public")
}

model AcompanhamentoMissionGroupMember {
  id              String                     @id @default(cuid())
  groupId         String
  projectId       String
  activeProjectId String?                    @unique
  order           Int                        @default(0)
  createdAt       DateTime                   @default(now())
  group           AcompanhamentoMissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([groupId, projectId])
  @@index([groupId, order])
  @@index([projectId])
  @@schema("public")
}

model ProjectReportSeq {
  id         String     @id @default(cuid())
  projectId  String
  reportType ReportType
  nextNumber Int        @default(0)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, reportType])
  @@schema("public")
}

model ProjectAuthorizedUser {
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@schema("public")
}

model Report {
  id                         String                            @id @default(cuid())
  projectId                  String
  createdByUserId            String?
  reviewedByUserId           String?
  reportType                 ReportType                        @default(RDO)
  sequenceNumber             Int?
  status                     ReportStatus                      @default(PENDING)
  reportDate                 DateTime
  arrivalTime                String
  departureTime              String
  lunchBreak                 String
  daytimeCount               Int
  daytimeWorkedMinutes       Int                               @default(0)
  nighttimeWorkedMinutes     Int                               @default(0)
  daytimeOvertimeMinutes     Int                               @default(0)
  nighttimeOvertimeMinutes   Int                               @default(0)
  totalOvertimeMinutes       Int                               @default(0)
  overtimeReason             String?
  dailyDescription           String?
  reviewNotes                String?
  specialConditions          Json?
  pendingDerivedTypes        Json?
  approvedAt                 DateTime?
  returnedAt                 DateTime?
  zapsignDocToken            String?
  zapsignSignerToken         String?
  zapsignRequestedAt         DateTime?
  zapsignSignedAt            DateTime?
  zapsignDocUrl              String?
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  deletedAt                  DateTime?
  project                    Project                           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy                  User?                             @relation("ReportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy                 User?                             @relation("ReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  collaborators              ReportCollaborator[]
  services                   ReportService[]
  attachments                ReportAttachment[]
  clientReviews              ClientReportReview[]
  versions                   ReportVersion[]
  reportSignatures           ReportSignature[]
  auditLogs                  ReportAuditLog[]
  approvalPostProcessingJobs ReportApprovalPostProcessingJob[]

  @@unique([projectId, reportType, sequenceNumber])
  @@index([projectId])
  @@index([createdByUserId])
  @@index([status])
  @@index([projectId, status])
  @@index([projectId, reportType])
  @@index([reportDate])
  @@index([zapsignDocToken])
  @@index([reportType, status, reportDate])
  @@index([projectId, reportType, status, reportDate])
  @@index([deletedAt])
  @@schema("public")
}

model ReportApprovalPostProcessingJob {
  id                 String    @id @default(cuid())
  reportId           String    @unique
  status             String    @default("PENDING")
  approvedTransition Boolean   @default(false)
  wasClientRejection Boolean   @default(false)
  reviewedByUserId   String?
  evidence           Json?
  attempts           Int       @default(0)
  lockedAt           DateTime?
  completedAt        DateTime?
  error              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  report             Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([status, lockedAt])
  @@index([createdAt])
  @@schema("public")
}

model ClientReportReview {
  id           String             @id @default(cuid())
  reportId     String
  clientUserId String?
  action       ClientReviewAction
  comment      String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime           @default(now())
  report       Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  clientUser   User?              @relation("ClientReportReviewer", fields: [clientUserId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@schema("public")
}

model ReportVersion {
  id                 String              @id @default(cuid())
  reportId           String
  versionNumber      Int
  sourcePdfUrl       String
  finalPdfUrl        String?
  sourceDocumentHash String
  finalDocumentHash  String?
  validationCode     String?             @unique
  status             ReportVersionStatus @default(ACTIVE)
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  report             Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation("ReportVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  signatures         ReportSignature[]
  auditLogs          ReportAuditLog[]

  @@unique([reportId, versionNumber])
  @@index([reportId])
  @@index([reportId, status])
  @@schema("public")
}

model ReportSignature {
  id                      String                @id @default(cuid())
  reportId                String
  versionId               String
  userId                  String?
  signerName              String
  declaredSignerName      String?
  signerEmail             String
  signerRole              ReportSignerRole
  signatureType           ReportSignatureType   @default(ELECTRONIC)
  status                  ReportSignatureStatus @default(PENDING)
  isRequired              Boolean               @default(true)
  ipAddress               String?
  userAgent               String?
  signatureImageDataUrl   String?
  privacyNoticeAcceptedAt DateTime?
  privacyNoticeVersion    String?
  sourceDocumentHash      String
  finalDocumentHash       String?
  signedAt                DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  invalidatedAt           DateTime?
  tokenHash               String?               @unique
  tokenEncrypted          String?
  tokenIv                 String?
  tokenAuthTag            String?
  tokenExpiresAt          DateTime?
  lastReminderAt          DateTime?
  reminderClaimedAt       DateTime?
  reminderCount           Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  report                  Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version                 ReportVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user                    User?                 @relation("ReportSignatureUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([versionId, signerEmail])
  @@index([reportId])
  @@index([versionId])
  @@index([status])
  @@index([status, lastReminderAt, reminderClaimedAt])
  @@schema("public")
}

model ReportAuditLog {
  id          String            @id @default(cuid())
  reportId    String
  versionId   String?
  userId      String?
  action      ReportAuditAction
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime          @default(now())
  report      Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version     ReportVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  user        User?             @relation("ReportAuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([versionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@schema("public")
}

model ReportCollaborator {
  reportId       String
  collaboratorId String
  report         Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@id([reportId, collaboratorId])
  @@schema("public")
}

model ReportService {
  id          String             @id @default(cuid())
  reportId    String
  serviceType String
  equipmentId String?
  system      String?
  material    String?
  startTime   String?
