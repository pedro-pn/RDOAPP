  RDO
  RTP
  RLQ
  RCPU
  RLM
  RLF
  RLI

  @@schema("public")
}

enum ReportStatus {
  PENDING
  APPROVED
  RETURNED
  SIGNED

  @@schema("public")
}

enum ClientReviewAction {
  APPROVED
  REJECTED

  @@schema("public")
}

enum ReportVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REJECTED

  @@schema("public")
}

enum ReportSignerRole {
  COLLABORATOR
  MANAGER
  CLIENT

  @@schema("public")
}

enum ReportSignatureType {
  ELECTRONIC
  DIGITAL_A1

  @@schema("public")
}

enum ReportSignatureStatus {
  PENDING
  SIGNED
  REJECTED
  INVALIDATED
  EXPIRED

  @@schema("public")
}

enum ReportAuditAction {
  SIGNATURE_ROUND_CREATED
  SIGNED
  REJECTED
  SIGNATURES_INVALIDATED
  VERSION_CREATED
  TOKEN_ACCESSED
  TOKEN_EXPIRED
  REPORT_LOCKED

