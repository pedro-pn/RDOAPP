generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Dois schemas na mesma instância: `public` é a operação do filtroAPP,
  // `comercial` é o módulo Comercial. Nenhum dado se move — as tabelas já
  // estão em `public`, e a anotação `@@schema` só informa ao Prisma onde
  // elas já estão. Ver §4.1 do docs/PLANO_MODULO_COMERCIAL.md.
  schemas  = ["public", "comercial"]
}

