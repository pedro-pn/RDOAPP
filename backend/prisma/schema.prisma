}

enum UserRole {
  COLLABORATOR
  MANAGER
  COORDINATOR
  CLIENT

  @@schema("public")
}

enum AccountType {
  ADMIN
  INTERNAL
  CLIENT

  @@schema("public")
}

enum AppModule {
